generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
}

enum BookingRequestStatus {
  PENDING
  IMPORTED
  REJECTED
  CANCELLED
}

enum BookingPublicRouteType {
  PROFILE
  WORKPLACE
}

enum AccountContactType {
  EMAIL
  PHONE
  TELEGRAM
}

enum CapabilityValueType {
  BOOLEAN
  LIMIT
}

enum TenantAccessStatus {
  ACTIVE
  SUSPENDED
}

enum TenantInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model Tenant {
  id                       String                     @id @default(cuid())
  name                     String
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  memberships              Membership[]
  workspaceStates          WorkspaceState[]
  profiles                 Profile[]
  bookingPublication       BookingPublication?
  bookingPublicRoutes      BookingPublicRoute[]
  createdAccounts          Account[]                  @relation("AccountCreatedViaTenant")
  accountLinks             AccountTenantLink[]
  bookingRequests          BookingRequest[]
  people                   Person[]
  ueiState                 UeiState?
  records                  Record[]
  recordEvents             RecordEvent[]
  events                   Event[]
  notes                    Note[]
  businessOperationalState BusinessOperationalState?
  documentArchive          TenantDocumentArchive?
  businessAuxiliaryState   BusinessAuxiliaryState?
  loyaltyDepositPrograms   LoyaltyDepositProgram[]
  loyaltyDepositInstances  LoyaltyDepositInstance[]
  financeSettlements       FinanceSettlement[]
  financeArticles          FinanceArticle[]
  financeOperations        FinanceOperation[]
  financeLedgerEntries     FinanceLedgerEntry[]
  saasAccess               TenantAccess?
  tenantInvitations        TenantInvitation[]
  activityEvents           PlatformActivityEvent[]
  notificationPreferences  PlatformNotificationPreference[]
  platformNotices          PlatformNotice[]
}

model PlatformAccount {
  id                      String                           @id @default(cuid())
  email                   String                           @unique
  passwordHash            String
  createdAt               DateTime                         @default(now())
  updatedAt               DateTime                         @updatedAt
  memberships             Membership[]
  workspaceStates         WorkspaceState[]
  profiles                Profile[]
  platformAdmin           PlatformAdmin?
  activityEvents          PlatformActivityEvent[]
  notificationPreferences PlatformNotificationPreference[]
  platformNotices         PlatformNotice[]
}

model Membership {
  id                String         @id @default(cuid())
  tenantId          String
  platformAccountId String
  role              MembershipRole @default(OWNER)
  createdAt         DateTime       @default(now())

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account PlatformAccount @relation(fields: [platformAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, platformAccountId])
  @@index([platformAccountId])
}

model WorkspaceState {
  id                String   @id @default(cuid())
  tenantId          String
  platformAccountId String
  data              Json
  revision          Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account PlatformAccount @relation(fields: [platformAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, platformAccountId])
  @@index([tenantId])
  @@index([platformAccountId])
}

model Profile {
  id                String   @id @default(cuid())
  tenantId          String
  platformAccountId String
  key               String   @default("profile")
  name              String   @default("")
  surname           String   @default("")
  phone             String   @default("")
  phones            Json
  telegrams         Json
  emails            Json
  about             String   @default("")
  photo             String   @default("")
  photoCropX        Int      @default(50)
  photoCropY        Int      @default(50)
  profession        String   @default("")
  experience        String   @default("")
  professionAbout   String   @default("")
  cardAppearance    Json     @default("{}")
  customProfessions Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account    PlatformAccount @relation(fields: [platformAccountId], references: [id], onDelete: Cascade)
  workplaces Workplace[]

  @@unique([tenantId, platformAccountId])
  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([platformAccountId])
}

model PlatformProfession {
  id             String   @id @default(cuid())
  normalizedName String   @unique
  name           String
  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([name])
  @@index([lastSeenAt])
}

model Workplace {
  id                       String   @id @default(cuid())
  tenantId                 String
  profileId                String
  key                      String
  position                 Int      @default(0)
  photo                    String   @default("")
  photoCropX               Int      @default(50)
  photoCropY               Int      @default(50)
  name                     String   @default("")
  color                    String   @default("")
  city                     String   @default("")
  address                  String   @default("")
  phone                    String   @default("")
  currency                 String   @default("RUB")
  timeZone                 String   @default("Europe/Moscow")
  from                     String   @default("09:00")
  to                       String   @default("18:00")
  links                    Json
  about                    String   @default("")
  cardAppearance           Json     @default("{}")
  visibleInPublicBooking   Boolean  @default(true)
  sourceCreatedAt          String   @default("")
  sourceUpdatedAt          String   @default("")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  deletedAt                DateTime?

  profile Profile @relation(fields: [profileId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
  @@index([profileId])
}

model BookingPublication {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  data      Json
  revision  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Account {
  id                 String   @id @default(cuid())
  createdViaTenantId String?
  email              String
  passwordHash       String
  name               String   @default("")
  surname            String   @default("")
  phone              String   @default("")
  telegramId         String   @default("")
  profileData        Json     @default("{}")
  discountPercent    Float    @default(0)
  visits             Int      @default(0)
  totalSpent         Float    @default(0)
  lastVisit          String   @default("")
  programs           Json     @default("[]")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  createdViaTenant Tenant?             @relation("AccountCreatedViaTenant", fields: [createdViaTenantId], references: [id], onDelete: SetNull)
  contacts            AccountContact[]
  tenantLinks         AccountTenantLink[]
  requests            BookingRequest[]
  calendarConnections AccountCalendarConnection[]

  @@index([createdViaTenantId])
}

model AccountCalendarConnection {
  id                   String   @id @default(cuid())
  accountId            String
  provider             String
  label                String   @default("")
  status               String   @default("active")
  encryptedCredentials String
  credentialsIv        String
  credentialsTag       String
  exportCalendarId     String   @default("")
  lastSyncAt           DateTime?
  lastError            String   @default("")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  account  Account                       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  bindings AccountCalendarBinding[]
  links    AccountCalendarItemLink[]

  @@unique([accountId, provider])
  @@index([accountId, status])
}

model AccountCalendarBinding {
  id                String   @id @default(cuid())
  connectionId      String
  externalCalendarId String
  name              String   @default("")
  enabled           Boolean  @default(true)
  writable          Boolean  @default(false)
  primary           Boolean  @default(false)
  timeZone          String   @default("UTC")
  collectionUrl     String   @default("")
  syncToken         String   @default("")
  channelId         String   @default("")
  channelResourceId String   @default("")
  channelToken      String   @default("")
  channelExpiresAt  DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  connection AccountCalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  links      AccountCalendarItemLink[]

  @@unique([connectionId, externalCalendarId])
  @@index([connectionId, enabled])
}

model AccountCalendarItemLink {
  id                    String   @id @default(cuid())
  connectionId          String
  bindingId             String
  localType             String
  localId               String
  externalId            String
  externalHref          String   @default("")
  externalEtag          String   @default("")
  lastExternalUpdatedAt String   @default("")
  lastLocalUpdatedAt    String   @default("")
  payloadHash           String   @default("")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  connection AccountCalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  binding    AccountCalendarBinding    @relation(fields: [bindingId], references: [id], onDelete: Cascade)

  @@unique([bindingId, externalId])
  @@unique([connectionId, localType, localId])
  @@index([connectionId, localType])
}

model AccountTenantLink {
  id        String   @id @default(cuid())
  accountId String
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([accountId, tenantId])
  @@index([tenantId, accountId])
  @@index([accountId, updatedAt])
}

model AccountContact {
  id        String             @id @default(cuid())
  accountId String
  type      AccountContactType
  value     String
  isPrimary Boolean            @default(false)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([type, value])
  @@index([accountId, type])
}

model BookingPublicRoute {
  id         String                 @id @default(cuid())
  tenantId   String
  entityType BookingPublicRouteType
  entityId   String
  scopeKey   String
  slug       String
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([entityType, entityId])
  @@unique([scopeKey, slug])
  @@index([tenantId, entityType])
}

model BookingRequest {
  id               String               @id @default(cuid())
  tenantId         String
  accountId        String
  workplaceKey     String
  date             String
  from             String
  to               String
  procedures       Json
  status           BookingRequestStatus @default(PENDING)
  importedRecordId String               @default("")
  recordSnapshot   Json?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, workplaceKey, date])
  @@index([accountId])
}

model Person {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  position  Int      @default(0)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId, position])
}

model UeiState {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Record {
  id        String   @id @default(cuid())
  tenantId  String
  recordId  String
  position  Int      @default(0)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, recordId])
  @@index([tenantId, position])
  @@map("BusinessRecord")
}

model RecordEvent {
  id        String   @id @default(cuid())
  tenantId  String
  eventId   String
  recordId  String
  position  Int      @default(0)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, eventId])
  @@index([tenantId, recordId])
  @@index([tenantId, position])
  @@map("BusinessRecordEvent")
}

model Event {
  id          String   @id
  tenantId    String?
  ownerType   String
  ownerId     String
  context     Json     @default("{}")
  date        String
  from        String
  to          String
  title       String
  description String   @default("")
  color       String   @default("#777A7D")
  workplaceId String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, workplaceId, date])
  @@index([ownerType, ownerId, date])
}

model Note {
  id         String   @id
  ownerType  String
  ownerId    String
  tenantId   String?
  context    Json     @default("{}")
  date       String
  from       String   @default("")
  to         String   @default("")
  targetType String   @default("")
  targetId   String   @default("")
  title      String   @default("")
  text       String   @default("")
  color      String   @default("#CFC3FF")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([ownerType, ownerId, date])
  @@index([tenantId, date])
  @@index([targetType, targetId])
}

model BusinessOperationalState {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model TenantDocumentArchive {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model BusinessAuxiliaryState {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model LoyaltyDepositProgram {
  id        String   @id @default(cuid())
  tenantId  String
  programId String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, programId])
  @@index([tenantId, createdAt])
}

model LoyaltyDepositInstance {
  id                String   @id
  tenantId          String
  depositId         String
  programId         String
  programName       String   @default("")
  personKey         String
  person            Json
  terms             Json
  initialAmount     Decimal  @db.Decimal(14, 2)
  principalBalance  Decimal  @db.Decimal(14, 2)
  benefitBalance    Decimal  @db.Decimal(14, 2)
  balance            Decimal  @db.Decimal(14, 2)
  status             String   @default("active")
  fundedAt           DateTime
  fundingOperationId String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, depositId])
  @@index([tenantId, personKey, status])
  @@index([tenantId, programId])
}

model FinanceArticle {
  id              String    @id @default(cuid())
  tenantId        String
  articleId       String
  parentArticleId String    @default("")
  name            String
  direction       String
  economicType    String
  systemKey       String    @default("")
  position        Int       @default(0)
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, articleId])
  @@index([tenantId, parentArticleId, position])
  @@index([tenantId, direction, archivedAt])
}

model FinanceSettlement {
  id         String   @id @default(cuid())
  tenantId   String
  sourceType String
  sourceId   String
  data       Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sourceType, sourceId])
  @@index([tenantId, sourceType])
}

model FinanceOperation {
  id                  String   @id @default(cuid())
  tenantId            String
  operationId         String
  kind                String
  status              String   @default("completed")
  sourceType          String
  sourceId            String
  originalOperationId String   @default("")
  occurredAt          DateTime
  data                Json
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ledgerEntries FinanceLedgerEntry[]

  @@unique([tenantId, operationId])
  @@index([tenantId, sourceType, sourceId])
  @@index([tenantId, occurredAt])
}

model FinanceLedgerEntry {
  id                 String   @id @default(cuid())
  tenantId           String
  financeOperationId String
  entryId            String
  walletId           String
  direction          String
  economicType       String
  amount             Decimal  @db.Decimal(14, 2)
  occurredAt         DateTime
  sourceType         String
  sourceId           String
  data               Json
  createdAt          DateTime @default(now())

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  operation FinanceOperation @relation(fields: [financeOperationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, entryId])
  @@index([tenantId, walletId, occurredAt])
  @@index([tenantId, sourceType, sourceId])
  @@index([financeOperationId])
}

model PlatformAdmin {
  id                String   @id @default(cuid())
  platformAccountId String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  account            PlatformAccount    @relation(fields: [platformAccountId], references: [id], onDelete: Cascade)
  createdInvitations TenantInvitation[]
}

model Capability {
  id             String              @id @default(cuid())
  key            String              @unique
  groupKey       String
  name           String
  description    String              @default("")
  valueType      CapabilityValueType
  defaultEnabled Boolean             @default(false)
  defaultLimit   Int?
  position       Int                 @default(0)
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  planValues      PlanCapability[]
  tenantOverrides TenantCapabilityOverride[]
  tenantOrders    TenantCapabilityOrder[]

  @@index([groupKey, position])
}

model Plan {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String   @default("")
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  capabilityValues PlanCapability[]
  tenantAccesses   TenantAccess[]
}

model PlanCapability {
  id           String   @id @default(cuid())
  planId       String
  capabilityId String
  enabled      Boolean?
  limit        Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  plan       Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  capability Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@unique([planId, capabilityId])
  @@index([capabilityId])
}

model TenantAccess {
  tenantId                        String             @id
  planId                          String?
  status                          TenantAccessStatus @default(ACTIVE)
  isOwnerBook                     Boolean            @default(false)
  commercialMode                  String             @default("DEMO")
  demoActivatedAt                 DateTime?
  demoExpiresAt                   DateTime?
  demoExtendedAt                  DateTime?
  liveRequestedAt                 DateTime?
  liveRequestedByPlatformAccountId String?
  liveApprovedAt                  DateTime?
  liveApprovedByAdminId           String?
  createdAt                       DateTime           @default(now())
  updatedAt                       DateTime           @updatedAt

  tenant          Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan            Plan?                      @relation(fields: [planId], references: [id], onDelete: SetNull)
  overrides       TenantCapabilityOverride[]
  capabilityOrder TenantCapabilityOrder[]

  @@index([planId])
  @@index([status])
}

model TenantCapabilityOverride {
  id           String   @id @default(cuid())
  tenantId     String
  capabilityId String
  enabled      Boolean?
  limit        Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenantAccess TenantAccess @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  capability   Capability   @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@unique([tenantId, capabilityId])
  @@index([capabilityId])
}

model TenantInvitation {
  id               String                 @id @default(cuid())
  tenantId         String
  createdByAdminId String
  email            String
  name             String                 @default("")
  tokenHash        String                 @unique
  status           TenantInvitationStatus @default(PENDING)
  expiresAt        DateTime
  acceptedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  activatedAt      DateTime?
  demoExpiresAt    DateTime?

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy PlatformAdmin @relation(fields: [createdByAdminId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([email, status])
  @@index([createdByAdminId])
}

model PlatformActivityEvent {
  id                String   @id @default(cuid())
  tenantId          String
  platformAccountId String?
  eventType         String
  metadata          Json     @default("{}")
  occurredAt        DateTime @default(now())
  createdAt         DateTime @default(now())

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account PlatformAccount? @relation(fields: [platformAccountId], references: [id], onDelete: SetNull)

  @@index([tenantId, occurredAt])
  @@index([platformAccountId, occurredAt])
  @@index([eventType, occurredAt])
}

model TenantCapabilityOrder {
  id           String   @id @default(cuid())
  tenantId     String
  capabilityId String
  position     Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenantAccess TenantAccess @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  capability   Capability   @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@unique([tenantId, capabilityId])
  @@index([tenantId, position])
  @@index([capabilityId])
}

model PlatformNotificationPreference {
  id                String   @id @default(cuid())
  tenantId          String
  platformAccountId String
  emailEnabled      Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account PlatformAccount @relation(fields: [platformAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, platformAccountId])
  @@index([platformAccountId])
}

model PlatformNotice {
  id                String   @id @default(cuid())
  tenantId          String
  platformAccountId String
  type              String
  title             String
  body              String   @default("")
  metadata          Json     @default("{}")
  readAt            DateTime?
  createdAt         DateTime @default(now())

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account PlatformAccount @relation(fields: [platformAccountId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([platformAccountId, readAt, createdAt])
}

model InventoryItem {
  id                String   @id @default(cuid())
  tenantId          String
  itemId            String
  name              String
  manufacturer      String   @default("")
  productType       String   @default("")
  unit              String   @default("шт.")
  category          String   @default("")
  sku               String   @default("")
  barcode           String   @default("")
  location          String   @default("")
  supplier          String   @default("")
  minStock          Decimal? @db.Decimal(14, 3)
  targetStock       Decimal? @db.Decimal(14, 3)
  packageQuantity   Decimal? @db.Decimal(14, 3)
  grossWeight       Decimal? @db.Decimal(14, 3)
  tareWeight        Decimal? @db.Decimal(14, 3)
  lastPurchasePrice Decimal? @db.Decimal(14, 4)
  trackLots         Boolean  @default(true)
  canConsume        Boolean  @default(true)
  canSell           Boolean  @default(false)
  position          Int      @default(0)
  archivedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  lots           InventoryLot[]
  movementLines  InventoryMovementLine[]
  supplierOffers InventorySupplierOffer[]

  @@unique([tenantId, itemId])
  @@index([tenantId, archivedAt, position])
  @@index([tenantId, manufacturer, name])
  @@index([tenantId, name])
}

model InventorySupplierOffer {
  id                String   @id @default(cuid())
  tenantId          String
  offerId           String
  inventoryItemId   String
  supplier          String
  listPrice         Decimal? @db.Decimal(14, 4)
  discountPercent   Decimal? @db.Decimal(7, 4)
  actualPrice       Decimal? @db.Decimal(14, 4)
  supplierSku       String   @default("")
  note              String   @default("")
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  item InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([tenantId, offerId])
  @@index([tenantId, inventoryItemId, supplier])
  @@index([tenantId, supplier])
}

model InventoryLot {
  id                String   @id @default(cuid())
  tenantId          String
  lotId             String
  inventoryItemId   String
  quantityReceived  Decimal  @db.Decimal(14, 3)
  quantityRemaining Decimal  @db.Decimal(14, 3)
  costKnown         Boolean @default(true)
  unitCost          Decimal  @db.Decimal(14, 4)
  listPrice         Decimal? @db.Decimal(14, 4)
  discountPercent   Decimal? @db.Decimal(7, 4)
  receivedAt        DateTime
  expiresAt         DateTime?
  supplier          String   @default("")
  note              String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  item        InventoryItem                 @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  allocations InventoryMovementAllocation[]

  @@unique([tenantId, lotId])
  @@index([tenantId, inventoryItemId, receivedAt])
  @@index([tenantId, inventoryItemId, quantityRemaining])
}

model InventoryMovement {
  id                 String   @id @default(cuid())
  tenantId           String
  movementId         String
  kind               String
  status             String   @default("completed")
  sourceType         String   @default("")
  sourceId           String   @default("")
  originalMovementId String   @default("")
  personKey          String   @default("")
  personUei          String   @default("")
  recordId           String   @default("")
  procedureKey       String   @default("")
  workplaceKey       String   @default("")
  note               String   @default("")
  occurredAt         DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  lines InventoryMovementLine[]

  @@unique([tenantId, movementId])
  @@index([tenantId, occurredAt])
  @@index([tenantId, sourceType, sourceId])
  @@index([tenantId, recordId])
}

model InventoryMovementLine {
  id                  String   @id @default(cuid())
  tenantId            String
  inventoryMovementId String
  inventoryItemId     String
  lineId              String
  position            Int      @default(0)
  direction           String
  quantity            Decimal  @db.Decimal(14, 3)
  costKnown         Boolean @default(true)
  unitCost            Decimal  @db.Decimal(14, 4)
  amount              Decimal  @db.Decimal(16, 4)
  expectedQuantity    Decimal? @db.Decimal(14, 3)
  actualQuantity      Decimal? @db.Decimal(14, 3)
  note                String   @default("")
  createdAt           DateTime @default(now())

  movement    InventoryMovement             @relation(fields: [inventoryMovementId], references: [id], onDelete: Cascade)
  item        InventoryItem                 @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  allocations InventoryMovementAllocation[]

  @@unique([tenantId, lineId])
  @@index([tenantId, inventoryMovementId, position])
  @@index([tenantId, inventoryItemId])
}

model InventoryMovementAllocation {
  id                      String   @id @default(cuid())
  tenantId                String
  inventoryMovementLineId String
  inventoryLotId          String
  allocationId            String
  quantity                Decimal  @db.Decimal(14, 3)
  unitCost                Decimal  @db.Decimal(14, 4)
  amount                  Decimal  @db.Decimal(16, 4)
  createdAt               DateTime @default(now())

  line InventoryMovementLine @relation(fields: [inventoryMovementLineId], references: [id], onDelete: Cascade)
  lot  InventoryLot          @relation(fields: [inventoryLotId], references: [id], onDelete: Restrict)

  @@unique([tenantId, allocationId])
  @@index([inventoryMovementLineId])
  @@index([inventoryLotId])
}

// Stable provenance links; business facts remain owned by their canonical domains.
model DataTransferFact {
  id         String   @id
  tenantId   String
  domain     String
  sourceKey  String
  targetId   String
  source     String
  input      Json
  ownership  Json     @default("{}")
  revision   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, domain, sourceKey])
  @@index([tenantId, domain, targetId])
}

// Technical audit of one actual transfer; canonical facts stay in their owners.
model DataTransferSession {
  id         String @id
  tenantId   String
  accountId  String
  source     String
  filename   String
  status     String @default("completed")
  transferred Int @default(0)
  failed     Int @default(0)
  facts      Json
  before     Json
  after      Json
  createdAt  DateTime @default(now())
  cancelledAt DateTime?
  @@index([tenantId, createdAt])
}
